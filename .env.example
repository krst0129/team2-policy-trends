# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. .env 는 GitHub에 올라가지 않습니다.
# 키가 없으면 해당 출처만 건너뛰고 나머지는 그대로 조사합니다.

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Programmable Search: API 키 + 검색엔진 ID(cx)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# (선택) Claude Code CLI 경로. 비워 두면 PATH와 Claude 데스크톱 앱 설치 위치에서 자동으로 찾습니다.
CLAUDE_BIN=

# (선택) 대시보드 포트
PORT=3000
